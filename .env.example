# Database (Vercel Postgres provides this connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estatehub

# JWT secret — generate a long random string for production
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Allowed CORS origin (set to your Vercel URL in production)
CLIENT_ORIGIN=http://localhost:5173

PORT=3001
NODE_ENV=development